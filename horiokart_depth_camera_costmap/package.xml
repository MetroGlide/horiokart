<?xml version="1.0"?>
<package format="2">
  <name>horiokart_depth_camera_costmap</name>
  <version>0.1.0</version>
  <description>Depth camera costmap layer plugin for Navigation2</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>
  <depend>nav2_costmap_2d</depend>

  <!-- Optional dependencies for improved pointcloud processing / eigen utilities -->
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>
  <depend>tf2_eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <pluginlib plugin="plugin.xml"/>
  </export>
</package>
