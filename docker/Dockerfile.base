# syntax=docker/dockerfile:1
ARG ROS_DISTRO=humble

# ==============================================================================
# Stage: runtime
# ==============================================================================
FROM ros:${ROS_DISTRO} AS runtime

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
  curl gnupg2 lsb-release python3-pip wget build-essential ca-certificates git \
  python3-argcomplete python3-colcon-common-extensions python3-rosdep \
  ros-${ROS_DISTRO}-ros2bag ros-${ROS_DISTRO}-ros2bag-* \
  ros-${ROS_DISTRO}-rosbag2-storage-mcap \
  ros-${ROS_DISTRO}-imu-tools \
  ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
  ros-${ROS_DISTRO}-librealsense2* \
  ros-${ROS_DISTRO}-realsense2-*

RUN pip3 install --no-cache-dir -U transforms3d

# --- pre-copy: 依存解決ファイルのみ先にコピー（キャッシュ最適化）---
# make build 実行時に docker/collect_deps.sh が docker/deps/ に自動収集する。
# docker/deps/ が空の場合も COPY は .gitkeep により成功し、後段でフォールバックする。
COPY docker/deps/ /app/

WORKDIR /root/ros2_ws/src
RUN ln -s /app ./horiokart

WORKDIR /root/ros2_ws
RUN python3 /app/docker/vcs_import.py -s src/horiokart -r -o src || true
RUN python3 /app/docker/pip_requirements.py -s src/horiokart -r || true
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && rosdep update --rosdistro ${ROS_DISTRO} \
  && rosdep install -yir --from-paths src --rosdistro ${ROS_DISTRO} || true

# --- full copy: 全ソースをコピーして確実にビルド ---
COPY . /app
RUN rm -rf /app/docker/deps/

RUN python3 /app/docker/vcs_import.py -s src/horiokart -r -o src
RUN python3 /app/docker/pip_requirements.py -s src/horiokart -r
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && rosdep update --rosdistro ${ROS_DISTRO} \
  && rosdep install -yir --from-paths src --rosdistro ${ROS_DISTRO}

RUN . /opt/ros/${ROS_DISTRO}/setup.sh && colcon build --symlink-install

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc \
  && echo "source /root/ros2_ws/install/setup.bash" >> ~/.bashrc

# ==============================================================================
# Stage: develop
# ==============================================================================
FROM runtime AS develop

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
  vim \
  qtbase5-dev libqt5svg5-dev libzmq3-dev libdw-dev \
  ros-${ROS_DISTRO}-rviz2 \
  ros-${ROS_DISTRO}-foxglove-bridge \
  ros-${ROS_DISTRO}-teleop-twist-keyboard \
  ros-${ROS_DISTRO}-rqt ros-${ROS_DISTRO}-rqt-*

# ==============================================================================
# Stage: simulation
# ==============================================================================
FROM develop AS simulation

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
  ros-${ROS_DISTRO}-ros-gz-sim \
  ros-${ROS_DISTRO}-ros-gz-bridge \
  ros-${ROS_DISTRO}-ros-gz-image \
  ros-${ROS_DISTRO}-ros-gz-interfaces

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y software-properties-common \
  && add-apt-repository ppa:kisak/kisak-mesa \
  && apt-get upgrade -y \
  && apt-get autoremove --purge -y

WORKDIR /root/ros2_ws
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && colcon build --symlink-install