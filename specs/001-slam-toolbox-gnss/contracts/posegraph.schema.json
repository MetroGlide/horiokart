{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PoseGraph",
    "type": "object",
    "properties": {
        "nodes": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "t": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "pose": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                    },
                    "cov": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    }
                },
                "required": [
                    "id",
                    "t",
                    "pose"
                ]
            }
        },
        "edges": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "from": {
                        "type": "integer"
                    },
                    "to": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string"
                    },
                    "meas": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    },
                    "info": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    }
                },
                "required": [
                    "from",
                    "to",
                    "type",
                    "meas"
                ]
            }
        }
    },
    "required": [
        "nodes",
        "edges"
    ]
}